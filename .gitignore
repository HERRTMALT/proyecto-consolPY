# Configuracion local de VS Code
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Archivos del sistema operativo
.DS_Store
Thumbs.db

# Archivos generados por analisis de datos
*.csv
*.xlsx
*.db
*.sqlite3
